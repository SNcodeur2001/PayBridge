# Serveur
PORT=4000

# Bitnob : sans les deux clés, le fournisseur simulé est automatiquement utilisé.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_WEBHOOK_SECRET=

# Clé Bearer optionnelle pour POST /api/payout (vide = ouvert en développement).
API_KEY=

# CORS : '*' ou liste CSV d'origines autorisées.
ALLOWED_ORIGINS=*

# URL publique du serveur (callback Bitnob/ngrok/cloudflared).
PUBLIC_BASE_URL=
